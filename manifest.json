{
  "manifest_version": 3,
  "name": "DeepSeek 沉浸翻译 (纯净自研版)",
  "version": "1.1.0",
  "description": "专为 AI 与科研工作流打造的纯净双语对照与划词翻译扩展，原生直连本地 DeepSeek 4.1，零商业套路，完全免费。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:7863/*",
    "http://localhost:7863/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js", "float.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepSeek 翻译设置"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "开启/关闭整页双语对照翻译"
    }
  }
}