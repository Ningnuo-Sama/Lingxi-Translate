{
  "manifest_version": 3,
  "name": "灵犀翻译 (Lingxi Translate)",
  "version": "1.2.0",
  "description": "开源本地 AI 网页沉浸翻译扩展：懂上下文、懂专业术语，支持仅译文与双语排版，直连本地大模型，零追踪零商业套路。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:7863/*",
    "http://localhost:7863/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js", "float.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "灵犀翻译设置"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "开启/关闭整页双语对照翻译"
    }
  }
}